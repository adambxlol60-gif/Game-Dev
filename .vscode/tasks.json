{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Game",
            "type": "shell",
            "command": "clang++",
            "args": [
                "main.cpp",
                "enemy.cpp",
                "-o", "game",
                "-I/opt/homebrew/Cellar/allegro/5.2.11.3/include",
                "-L/opt/homebrew/Cellar/allegro/5.2.11.3/lib",
                "-lallegro",
                "-lallegro_image",
                "-lallegro_dialog",
                "-lallegro_main",
                "-std=c++17"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"]
        }
    ]
}
